<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" name="XMLConfigTest">
    <Filter type="ThresholdFilter" level="trace" />

    <Appenders>
        <!-- Вывод в консоль -->
        <Console name="STDOUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %m%n" />
        </Console>

        <!-- Маршрутизатор логов по файлам -->
        <Routing name="ROUTING_APPENDER">
            <!-- Проверяем имя файла из контекста потока -->
            <Routes pattern="$${ctx:logFileName}">
                <Route>
                    <!-- ИСПРАВЛЕНО: Убрали динамическую дату из fileName для исключения конфликта потоков -->
                    <File name="ThreadLog-${ctx:logFileName}"
                          fileName="logs/${ctx:logFileName}.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{36} - %m%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="STDOUT" />
            <AppenderRef ref="ROUTING_APPENDER" />
        </Root>
    </Loggers>
</Configuration>
